{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    { "src": "index.html",  "use": "@vercel/static" },
    { "src": "modern.css",  "use": "@vercel/static" },
    { "src": "public/**/*", "use": "@vercel/static" },
    { "src": "*.png",       "use": "@vercel/static" },
    { "src": "*.jpg",       "use": "@vercel/static" },
    { "src": "*.webp",      "use": "@vercel/static" },
    { "src": "*.ico",       "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/(.*\\.[^/]+)$", "dest": "/$1" },
    { "src": "/[^.]*", "dest": "/index.html" }
  ],
  "headers": [
    { "source": "/modern.css", "headers": [{ "key": "cache-control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
