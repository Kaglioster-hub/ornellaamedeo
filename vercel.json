{
  "version": 2,
  "builds": [
    { "src": "index.html",  "use": "@vercel/static" },
    { "src": "modern.css",  "use": "@vercel/static" },
    { "src": "*.png",       "use": "@vercel/static" },
    { "src": "*.jpg",       "use": "@vercel/static" },
    { "src": "*.webp",      "use": "@vercel/static" },
    { "src": "*.ico",       "use": "@vercel/static" },
    { "src": "public/**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/(.*\\.[^/]+)$", "dest": "/$1" },
    { "src": "/[^.]*", "dest": "/index.html" }
  ]
}
